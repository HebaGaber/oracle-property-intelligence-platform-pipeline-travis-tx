{
  "extends": "./tsconfig.base.json",
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/scripts/**/*.ts",
    "packages/*/gazetteer/**/*.ts",
    "profiles/*/*.ts",
    "profiles/*/scripts/**/*.ts",
    "profiles/*/test/**/*.ts",
