{
  "name": "@countylens/e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Hosted Playwright harness (A-03 T023): one test per G6 test case, tagged @scenario:A-03-TC-nnn, run only against RUNTIME_URL (never localhost).",
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "e2e:list": "playwright test --list",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/client-ssm": "^3.1154.0",
    "@aws-sdk/credential-providers": "^3.1154.0",
    "@countylens/contract": "workspace:*",
    "@countylens/publish": "workspace:*",
    "@ipld/car": "^5.4.7",
    "@ipld/dag-json": "^11.0.1",
    "@smithy/shared-ini-file-loader": "^4.7.2",
    "multiformats": "^14.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
